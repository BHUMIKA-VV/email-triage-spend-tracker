# LLM provider: auto | anthropic | openai | gemini | groq | rules
#   auto  -> first key found: ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY, GROQ_API_KEY; else rules
#   gemini / groq have FREE tiers (no card): aistudio.google.com/apikey, console.groq.com/keys
#   rules -> offline deterministic keyword/regex engine (no API key, no cost)
LLM_PROVIDER=auto
# Optional model override (defaults: claude-haiku-5-5 / gpt-4o-mini / gemini-3.8-flash / openai/gpt-oss-120b)
LLM_MODEL=
LLM_TEMPERATURE=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Retry policy for each LLM call (exponential backoff: base, 2x base, 4x base ...)
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_TIMEOUT_SECONDS=60

# Human-in-the-loop gates
REVIEW_CONFIDENCE_THRESHOLD=0.7
SPEND_REVIEW_THRESHOLD_INR=10000

# Same merchant + amount within N days = same purchase
DEDUP_WINDOW_DAYS=3

# Parallel Send workers (bounds concurrent LLM calls)
MAX_CONCURRENCY=4

# SQLite checkpoint database
CHECKPOINT_DB=checkpoints.sqlite
